{
  "rules": {
    ".read": false,
    ".write": false,

    "joinCodes": {
      ".read": false,
      ".write": false
    },
    "private": {
      ".read": false,
      ".write": false
    },

    "locations": {
      ".read": false,
      "$roomId": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && root.child('rooms').child($roomId).child('access').child('phase').val() === 'playing' && root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('status').val() === 'active' && (!data.exists() || now - data.child('t').val() >= 2000)",
          ".validate": "newData.hasChildren(['lat', 'lng', 't'])",
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "acc": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "t": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "rooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          "$uid": {
            "name": {
              ".write": "auth != null && auth.uid === $uid && data.exists() && newData.exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            }
          }
        },
        "presence": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['online', 'lastChanged'])",
            "online": { ".validate": "newData.isBoolean()" },
            "lastChanged": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "access": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
        },
        "public": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
        },
        "channels": {
          "hunterPositions": {
            ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && root.child('rooms').child($roomId).child('access').child('phase').val() === 'playing' && ((root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('role').val() === 'hunter' && root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('status').val() === 'active') || root.child('rooms').child($roomId).child('access').child('showHunters').val() === true)"
          },
          "runnerPositions": {
            ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && root.child('rooms').child($roomId).child('access').child('phase').val() === 'playing' && root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('role').val() === 'runner' && root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('status').val() === 'active'"
          },
          "possibleAreas": {
            ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && root.child('rooms').child($roomId).child('access').child('phase').val() === 'playing' && root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('role').val() === 'hunter' && root.child('rooms').child($roomId).child('access').child('players').child(auth.uid).child('status').val() === 'active'"
          }
        },
        "views": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          }
        },
        "results": {
          "public": {
            ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
          },
          "personal": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
            }
          }
        }
      }
    }
  }
}
